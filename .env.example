# ============================================================
# SMART WALLET FLOW — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no git.
# ============================================================

# Banco de dados PostgreSQL (obrigatório)
# Exemplo Neon: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Segredo da sessão — gere um valor aleatório forte:
# Node.js: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GERE_UM_SECRET_FORTE_AQUI

# Chave da API Gemini (Google AI) — para OCR, voz e chat IA
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=SUA_CHAVE_GEMINI_AQUI

# Porta do servidor (opcional, padrão: 5000)
PORT=5000
